@model AncientCitiesVSA.Features.CityType.DTOs.CityTypeDTO

@{
    ViewData["Title"] = Model.Id == 0 ? "Create City Type" : "Edit City Type";
    Layout = "_Layout";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Upsert" method="post">
    <div class="form-group mt-3 mb-3">
        <label for="Name">Name</label>
        <input id="Name" name="Name" value="@Model.Name" class="form-control" />
    </div>

    <input type="hidden" asp-for="@Model.Id" />

    <button type="submit" class="btn btn-primary">Save</button>
    <a href="@Url.Action("Index", "CityType")" class="btn btn-secondary">Cancel</a>
</form>